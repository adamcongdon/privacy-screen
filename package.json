{
  "name": "privacy-screen",
  "version": "0.0.1",
  "description": "Local-first PII anonymization layer for AI providers",
  "type": "module",
  "scripts": {
    "test": "bun test tests/",
    "cli": "bun cli/PrivacyScreen.ts",
    "hook": "bun hooks/PrivacyScreen.hook.ts",
    "lint": "bunx tsc --noEmit",
    "server": "bun --watch server/server.ts",
    "web:dev": "cd web && bunx vite",
    "web:build": "cd web && bunx vite build",
    "start": "bun run web:build && bun run server",
    "version:bump": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.5",
    "keytar": "^7.9.0",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "4.12.3",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
